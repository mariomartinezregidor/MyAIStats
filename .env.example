# MyAIStats Local Configuration
# Copy this file to .env and customize if needed.

# Host & Port (Local-first: bound to 127.0.0.1 by default for security)
MYAISTATS_HOST=127.0.0.1
MYAISTATS_PORT=8000

# Database URL (SQLite local database)
MYAISTATS_DATABASE_URL=sqlite:///./data/myaistats.db

# Encryption Master Key (Fernet 32-byte url-safe base64 key)
# If left empty, MyAIStats automatically generates and persists a local key in ./data/.secret.key (0600 permissions)
MYAISTATS_SECRET_KEY=

# Frontend CORS origin
MYAISTATS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default Display Currency (USD or EUR)
MYAISTATS_DEFAULT_CURRENCY=USD

# Demo Mode (true shows clearly labeled demo data alongside or before real accounts are connected)
MYAISTATS_DEMO_MODE=true

# Background Sync Intervals (in minutes)
MYAISTATS_SYNC_USAGE_INTERVAL_MINUTES=15
MYAISTATS_SYNC_COSTS_INTERVAL_MINUTES=30
MYAISTATS_SYNC_BALANCES_INTERVAL_MINUTES=30
MYAISTATS_SYNC_PRICING_INTERVAL_MINUTES=1440
